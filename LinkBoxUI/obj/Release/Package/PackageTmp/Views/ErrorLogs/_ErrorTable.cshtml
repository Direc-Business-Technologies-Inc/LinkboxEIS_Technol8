@model string
@* Model = category key sent to ErrorLogsController.GetErrors: "platform" | "primary" | "other" *@

<div class="box">
    <div class="box-header">
        <h3 class="box-title"><i class="fa fa-database"></i> List of Errors</h3>
    </div>
    <div class="box-body">
        <table class="table table-bordered table-striped"
               id="error-list-@Model"
               data-category="@Model"
               style="width:100%">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Task</th>
                    <th>Error Message</th>
                    <th>Create Date</th>
                    <th>OrderId</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
