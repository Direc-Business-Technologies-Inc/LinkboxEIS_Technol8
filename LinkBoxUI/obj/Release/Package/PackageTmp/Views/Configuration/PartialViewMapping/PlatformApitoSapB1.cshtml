 function GetSAPFields(onefieldsap, onefieldmod, execute) {
    return new Promise((resolve, reject) => {
        if (!execute) {
            resolve(null); // nothing to do, resolve immediately so await doesn't hang
            return;
        }

        $.post("@Url.Action("FetchSAPAPIData", "Configuration")", {
            Code: onefieldsap,
            Module: onefieldmod,
        }).done(function (data) {
            if (data) {
                const myJSON = JSON.parse(data);
                destinationJson = myJSON;
                console.log("My Destination");
                console.log(destinationJson);

                $(`#saptable`).empty();
                Object.entries(destinationJson.Rows).forEach(([key, value]) => {
                    $(`#saptable`).append($('<option>', {
                        value: key,
                        text: key
                    }));
                });

                $('#preloader-modal').modal('hide');
                resolve(destinationJson); // FIXED: resolve once everything's actually set
            } else {
                resolve(null);
            }
        }).fail(function () {
            swal('Something went wrong.', 'Please contact the administrator.', 'warning');
            reject('FetchSAPAPIData failed');
        });
    });
}

    function testApiConnection() {
        return new Promise((resolve, reject) => {
            var apiCode = $('#api-field-code').val();
            var relativePath = $("#api-field-s-source").val();
            var order_nmber = $("#ordernumber").val();

            var selectedPlatform = $('#api-field-s-source option:selected').text();

            if (!relativePath || !order_nmber || !apiCode) {
                alert("API Code or Order number is empty");
                reject("Missing source or order number");
                return;
            }
            var fullUrl = window.location.origin + relativePath;

            $.ajax({
                url: fullUrl,
                method: "GET",
                data: {
                    ordernumber: order_nmber,
                    code: apiCode
},
                success: function (response) {
                    if (response.Code != "0") {
                        swal(response.Message, '', 'info')
                    }
                    //else if (selectedPlatform == "Lazada" && response != "0") {
                    //    alert(response)
                    //    swal("INAMO", '', 'info')
                    //}
                    else {
                        SourceColumnValues = response.Data;
                        //swal('Successfully Generated', '', 'success')
                        console.log("Retrieved:", response.Data);
                        resolve(response);
                    }
                 
                },
                error: function (xhr, status, error) {
                    console.error("Error:", xhr.responseText);
                    alert("API call failed: " + xhr.responseText);
                    reject(xhr.responseText);
                }
            });
        });
    }
</script>