<script>
    let destinationJson = [];
    $(document).ready(function () {

        $('#field-module').on('change', function (e, skipFetch) {
            $('#preloader-modal').modal('show');
            let onefieldsap = $('#field-sap').val();
            let onefieldmod = $('#field-module').val();

            if (skipFetch) {
                return; // triggered from the map-load flow — skip, we'll call GetSAPFields explicitly ourselves
            }
            GetSAPFields(onefieldsap, onefieldmod, true);
           // console.log(onefieldsap)
           // console.log(onefieldmod)
           //if (onefieldsap != "" && $(this).val() != "") {
                
           // }

        })




        $('#mysql-field-module').on('change', function () {

            $('#preloader-modal').modal('show');
            let fieldsap = $('#mysql-field-sap').val();
            let fieldmodule = $('#mysql-field-module').val();

            if (fieldsap != "" && $(this).val() != "") {
                $.post("@Url.Action("FetchSAPAPIData", "Configuration")", {
                    Code: fieldsap,
                    Module: fieldmodule,
                }).done(function (data) {
                    if (data) {

                        const myJSON = JSON.parse(data);
                        destinationJson = myJSON;

                        $(`#mysql-saptable`).empty();
                        Object.entries(destinationJson.Rows).forEach(async ([key, value]) => {
                            /*console.log(destinationJson);*/
                            $(`#mysql-saptable`).append($('<option>', {
                                value: key,
                                text: key
                            }));
                        });

                        $('#preloader-modal').modal('hide');

                    }
                }).fail(function () {
                    swal('Something went wrong.', 'Please contact the administrator.', 'warning')
                });
            }

        })



    });
</script>

<script>


    var SourceColumnValues = [];
    var TableSaveValue = [];
    var tabTextList = []
    var createorupdate = 0, Mapid = 0;
    var counth = 0, countr = 0;

    var mapid = 0;
    $(document)


        .on('click', 'button[field-tablename]', async function () {
          
            $(this).prop('disabled', true);

            const tablename = $(this).attr('field-tablename');
             

            const tbodytr = $(`#field-row-table-${tablename} tr`).length;
            let index = tbodytr;

            countr = index;

            filecomboid = "field-source-rowcombo_" + tablename + countr;
            fileapicombo = "field-dest-rowapicombo_" + tablename + countr;
            //datatypeid = "one-field-rowdata_" + tablename + countr;
            conditionid = "field-rowcondition_" + tablename + countr;
            checkid = "field-rowcheck_" + tablename + countr;


            $(`#field-row-table-${tablename} tbody`).append('<tr id=""><td width="5%"><button type="button" class=" form-control btn-info btn-flat fa fa-trash" data-headid = "" ></button></td>' +
                '<td><select class="form-control select2 field-source-rowcombo" name ="" data-visorder="0" style="width: 100%;" id="' + filecomboid + '"></select></td>' +
                '<td><select class="form-control select2 field-dest-apicombo" name="" style="width: 100%;" id="' + fileapicombo + '" data-table="' + tablename + '"></select></td>' +
/*                '<td><input type="text" class="form-control ops-field-rowdatatype" placeholder="Data Type" id="' + datatypeid + '" readonly></td>' +*/
                '<td><input type="text" class="form-control field-rowcondition" placeholder="Value" id="' + conditionid + '"></td>' +
                '<td style="display:flex; justify-content:center; align-items:center;"><input type="checkbox" style="transform: scale(2.0);" class="iCheck-helper headercheck" id="' + checkid + '" /></</td>' +
                '</tr > ');


            //Source Field
            populateCombo(filecomboid);


            //console.log("My Destination version 2")
            //console.log(destinationJson)
            ///Destination Field

                Object.entries(destinationJson.Rows[tablename]).forEach(async ([keyr, value]) => {
                    ///console.log(`Key:${key} | KeyR:${keyr}`);
                    $(`#${fileapicombo}`).append($('<option>', {
                        value: keyr,
                        text: keyr
                    }));

                });



                $(this).prop('disabled', false);



            $('.select2').select2();


        })

        .on('click', '#add-table', function () {

            var APICode = $('#api-field-s-source').val();
            var key = $('#saptable').val();


            if (!APICode || !key) {
                swal("Fail", 'API Code and SAP Table must have a value', 'warning');
                return;
            }
            if (tabTextList.includes(key)) {
                swal("Fail", 'SAP Table Already Exist', 'warning');
                return;
            }
            if (!SourceColumnValues || SourceColumnValues.length === 0) {
                swal("Fail", 'Please Trigger the Test Connection on API Before Adding Table');
                return;
            }

            swal({
                title: 'Are you sure you want to Create this Table?',
                text: "",
                type: 'info',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes',
                allowOutsideClick: false
            }).then((result) => {

                if (result.value) {

                    let tabCount = $('#field-tabs li').length + 1;
                    isActive = true
                    $('#field-tabs').append(`<li class="row-append"> <a href="#tab_${tabCount}" data-toggle="tab"> <button type="button" class="btn-info fa fa-trash" data-delete=${key}> </button> ${key}</a> </li>`);

                    $(`#field-tab-content`).append(`
                    <div class="tab-pane ${isActive} row-append" id="tab_${tabCount}">
                       <div class="box">
                           <div class="box-header">
                               <h3 class="box-title">

                               </h3>

                           </div>
                           <div class="box-body">
                               <table id="field-row-table-${key}" data-tablename="${key}" class="table field-table-rows table-fields table-bordered table-striped">
                                   <thead>
                                       <tr>
                                           <th></th>
                                           <th>Source Field</th>
                                           <th>Destination SAP Field</th>
                                           <th>Conditional Value</th>
                                           <th>isKeyValue</th>

                                       </tr>
                                   </thead>
                                   <tbody class="fieldrow-tbody" data-tablesap="" id="field-row-tbody-${key}"></tbody>
                               </table>
                           </div>
                           <div class="box-footer">
                               <button type="button" class="btn btn-primary newfield" style="float: right;" data-index="0"  field-tablename="${key}" id="field-add-rowfield-${key}">New Field</button>
                           </div>
                       </div>
                   </div>
               `);


                    $('#field-tabs li:last-child a').tab('show');

                    tabTextList.push(key);
                }//end of result.value

            })//end of then

        })

        .on('shown.bs.tab', '#field-tabs', function (event) {

            var hreftext = $(event.target).text().trim();

            $('#saptable').val(hreftext).trigger('change');

        })

        .on('click', '#api-test-connect', function () {


            var apiCode = $('#api-field-code').val();
            var relativePath = $("#api-field-s-source").val();
            var order_nmber = $("#ordernumber").val();

            var selectedPlatform = $('#api-field-s-source option:selected').text();
        

            if (!relativePath || !order_nmber || !apiCode) {
                alert("API Code or Order number is empty");
                return;
