@model DomainLayer.ViewModels.MapCreateViewModel

<section class="content-header">
    <h1>
        Field Mapping Configuration version
    </h1>
    <div class="row" id="map-selection">
        <div class="register-box">
            <div class="box">
                <div class="register-box">
                    <div class="modal-header">
                        <h4 class="modal-title">Field Mapping Option</h4>
                    </div>
                    <div class="register-box-body">
                        <div class="social-auth-links text-center">
                            <p>What data do you want to MAP?</p>

                        </div>

                        <select class="form-control" id="mdal-map-option" style="width: 100%;" required>

                            <option value="mysql-sap-submit" hidden>Using MySQL Database to SAP</option>
                            <option value="shopify-api-netsuite-submit" selected>Using Shopify API to Netsuite</option>
                            <option value="one-map-submit" hidden>Using Data File to SAP [One Per Sheet]</option>



                        </select>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-primary" id="mdal-btn-map-next">NEXT</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row" id="back-selection" hidden>
        <div class="col-md-12">
            <div class="box">
                <div class="btn-group">
                    <button class="btn btn-primary pull-left " id="btn-back-select">Back</button>
                </div>
            </div>
        </div>
    </div>



    <div id="partial-view-container">

    </div>
</section>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#mdal-btn-map-next').click(function () {
                var selectedOption = $('#mdal-map-option').val();

                $.post('/Configuration/LoadMapping', { mappingOption: selectedOption }, function (result) {
                    $('#map-selection').hide();
                    $('#back-selection').show();
                    $('#partial-view-container').html(result);
                }).fail(function () {
                    alert('Failed to load Partial. Please try again.');
                });
            });

            $('#btn-back-select').click(function () {
                $('#map-selection').show();
                $('#back-selection').hide();
                $('#partial-view-container').empty();
            });
        });
    </script>
