<script>
    let destinationJson = [];
    $(document).ready(function () {

        $('#field-module').on('change', function (e, skipFetch) {
            $('#preloader-modal').modal('show');
            let onefieldsap = $('#field-sap').val();
            let onefieldmod = $('#field-module').val();

            if (skipFetch) {
                return; // triggered from the map-load flow — skip, we'll call GetSAPFields explicitly ourselves
            }
            GetSAPFields(onefieldsap, onefieldmod, true);
           // console.log(onefieldsap)
           // console.log(onefieldmod)
           //if (onefieldsap != "" && $(this).val() != "") {

           // }

        })




        $('#mysql-field-module').on('change', function () {

            $('#preloader-modal').modal('show');
            let fieldsap = $('#mysql-field-sap').val();
            let fieldmodule = $('#mysql-field-module').val();

            if (fieldsap != "" && $(this).val() != "") {
                $.post("@Url.Action("FetchSAPAPIData", "Configuration")", {
                    Code: fieldsap,
                    Module: fieldmodule,
                }).done(function (data) {
                    if (data) {

                        const myJSON = JSON.parse(data);
                        destinationJson = myJSON;

                        $(`#mysql-saptable`).empty();
                        Object.entries(destinationJson.Rows).forEach(async ([key, value]) => {
                            /*console.log(destinationJson);*/
                            $(`#mysql-saptable`).append($('<option>', {
                                value: key,
                                text: key
                            }));
                        });

                        $('#preloader-modal').modal('hide');

                    }
                }).fail(function () {
                    swal('Something went wrong.', 'Please contact the administrator.', 'warning')
                });
            }

        })



    });
</script>

<script>


    var SourceColumnValues = [];
    var TableSaveValue = [];
    var tabTextList = []
