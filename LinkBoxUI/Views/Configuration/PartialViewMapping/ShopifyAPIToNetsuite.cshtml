        .on('submit', '#map-submit', function (e) {
            e.preventDefault();


            //var sourceDestinationTb = [];

            var mapping = [];
            var check = createorupdate
            var MapId = Mapid;

            var sourceparam = [];
            var destparam = [];



            var FieldCode = $('#field-code').val();
            var FieldName = $('#field-name').val();

            var SourceAPICode = $('#api-field-s-source').val();
            var DestAPICode = $('#api-field-d-source').val();



            //var source_param = $('.field-table-s-rows');

                $(`#api-param-s-tbody tr`, this).each(function () {
                    //const sObject = {
                    //    key: $('.api-param-s-key', this).val(),
                    //    value: $('.api-param-s-value', this).val(),
                    //    type:"source"
                    //};
                    //var key = $('.api-param-s-key', this).val();
                    //var value = $('.api-param-s-value', this).val();
                    //var type = "source";  // Add type "source"

                    sourceparam.push([$('.api-param-s-key', this).val(), $('.api-param-s-value', this).val(), "source"]);
                })

            ///console.log(sourceparam)



            $(`#api-param-d-tbody tr`, this).each(function () {
                //const dObject = {
                //    key: $('.api-param-d-key', this).val(),
                //    value: $('.api-param-d-value', this).val(),
                //    type: "dest"
                //};
                destparam.push([$('.api-param-d-key', this).val(), $('.api-param-d-value', this).val(), "dest"]);
            })


            var rowTables = $('.field-table-rows');
            var IsRequired = false;
            var i = 0;

            $('#field-tabs li').each(function () {
                let tabText = $(this).find('a').text().toLowerCase(); // Get the text of the <a> tag inside each <li>
                let table = $(this).find('a').text();

                // Loop through each row of the corresponding table
                let visorder = 1;  // Reset visorder for each table row
                $('#' + tabText + '-table tbody tr').each(function () {

                    // Increment the order before assignment to track row order
                    let order = visorder++;

                    // Get the values of the source, dest, query, and check elements for this row
                    let source = $('.' + tabText + 'source', this).val();
                    let dest = $('.' + tabText + 'dest', this).val();
                    let query = $('.' + tabText + 'query', this).val();
                    let check = $('.' + tabText + 'check', this).prop('checked');

                    if (check) {
                        check = 1;
                    } else {
                        check = 0;
                    }

                    // Get the text from the row's <a> tag (may be redundant depending on the context)

                    // Optional: mapid could be used or removed if not needed
                      // Placeholder if needed later

                    // Push the collected data into the mapping array
                    mapping.push([source, dest, query, check, table, order, mapid]);

                    // Log to console for debugging

                });
            });


            console.log(mapping)


            swal({
                title: 'Are you sure you want to save this Field mapping Setup?',
                text: "",
                type: 'info',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes'
            }).then((result) => {

                if (result.value) {

                    $('#preloader-modal').modal('show');

                    $.post("@Url.Action("CreateMapping", "Configuration")", {

                        MapId: MapId,
                        MapCode: FieldCode,
                        MapName: FieldName,
                        APICode: SourceAPICode,
                        SAPCode: DestAPICode,
                        Source: sourceparam,
                        Dest: destparam,
                        MapFields: mapping
                        }).done(function (data) {
                        $('#preloader-modal').modal('hide');
                        if (data) {
                            swal({
                                title: "Success!",
                                text: "",
                                type: "success",
                                showConfirmButton: false,
                                timer: 1500,
                                onClose: () => {
                                    window.location.href = "";
                                }
                            });
                        }
                    }).fail(function () {
                        swal('Something went wrong.', 'Please contact the administrator.', 'warning')
                    });

                }

            }) // end of Swal

            $('#preloader-modal').modal('hide');

        })


