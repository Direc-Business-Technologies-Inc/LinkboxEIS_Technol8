</form>


<div class="modal fade" id="api-modal-source">
    <div class="modal-dialog modal-lg">
        <div class="modal-content ">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">API Details</h4>
            </div>
            <div class="modal-body">
                <div class="box-body">
                    <table id="api-APIConfig" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Code</th>
                                <th>Method</th>
                                <th>URL</th>
                                @*<th>Key</th>*@
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var apis in Model.APIView)
                            {
                                <tr>
                                    <td>@apis.APIId</td>
                                    <td>@apis.APICode</td>
                                    <td>@apis.APIMethod</td>
                                    <td>@apis.APIURL</td>
                                    @*<td>@apis.APIKey</td>*@
                                    <td><button class="btn-info fa fa-arrow-circle-o-right" data-api-apisourceid="@apis.APIId"></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default btn-custom2 " data-dismiss="modal">Close</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

