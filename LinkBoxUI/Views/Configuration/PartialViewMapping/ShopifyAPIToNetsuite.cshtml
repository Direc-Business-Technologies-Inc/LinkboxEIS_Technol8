                                    <table id="api-param-s-table" class="table table-fields table-bordered table-striped field-table-s-rows">
                                        <thead>
                                            <tr>
                                                <th></th>
                                                <th>Parameter Key</th>
                                                <th>Value</th>
                                            </tr>
                                        </thead>
                                        <tbody id="api-param-s-tbody"></tbody>
                                    </table>
                                    <div class="box-footer" style="padding-bottom:0px;">
                                        <button type="button" class="btn margin btn-primary" style="float: right;" id="api-add-s-parameter">New Parameter</button>
                                    </div>
                                </div>*@

                            </div>


                        </div>






                    </div>
                </div>
                <!-- /.box-body -->
                <!--</div>-->
                <!-- /.box -->
                <!--THIS IS THE END OF THE NEW ONE-->

            </div>


            <!-- /.Destination -->
            <div class="col-md-6 offset-md-6">
                <div class="box box-solid">
                    <div class="box-body">

                        <div class="col-md-12">

                            <div class="form-group" id="field-sap-formgroup">
                                <label>API Code:</label>
                                <div class="input-group">
                                    <div class="input-group-addon">
                                        <i class="fa fa-server"></i>
                                    </div>
                                    <input type="text" class="form-control" maxlength="20" placeholder="API Code" id="api-field-d-source" readonly required>
                                    <div class="input-group-addon" id="api-open">
                                        <button type="button" class="btn-info fa fa-hand-o-right" style="float: right;" data-toggle="modal" data-target="#api-modal-dest"></button>
