                                <div class="input-group">
                                    <div class="input-group-addon">
                                        <i class="fa fa-code"></i>
                                    </div>
                                    <input type="text" class="form-control mapcode" placeholder="Code" id="field-code" required>
                                    <div class="input-group-addon" id="open">
