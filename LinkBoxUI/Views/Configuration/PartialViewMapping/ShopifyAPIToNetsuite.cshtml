                                        <i class="fa fa-pencil-square-o"></i>
                                    </div>
                                    <input type="text" class="form-control" placeholder="Name" id="field-name" required>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
                <!-- /.box-body -->
            </div>

            <!-- /.box -->
