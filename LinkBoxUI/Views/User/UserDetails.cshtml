            e.preventDefault();
            if (!($('#firstNameFormGroup').hasClass('error'))) {
                $('#firstNameFormGroup').append('<span class="help-block text-red">First Name is Required</span>');
            }
            $('#firstNameFormGroup').addClass('error');
        });

        $("#editLName").on("invalid", function (e) {
