    </script>

    <script>
        $('input:checkbox[id = selectAll]').on('ifChecked', function (event) {
            $('input:checkbox[name = select]').iCheck('check');
        });

        $('input:checkbox[id = selectAll]').on('ifUnchecked', function (event) {
            $('input:checkbox[name = select]').iCheck('uncheck');
        });

